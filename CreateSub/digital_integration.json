{
    "definition": {
        "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
        "contentVersion": "1.0.0.0",
        "triggers": {
            "Http_Request_Trigger": {
                "type": "Request",
                "kind": "Http",
                "inputs": {
                    "method": "POST",
                    "schema": {
                        "type": "object",
                        "required": [
                            "u_catalog_task_sysid",
                            "u_ritm_number"
                        ],
                        "properties": {
                            "u_catalog_task_sysid": {
                                "type": "string"
                            },
                            "u_ritm_number": {
                                "type": "string"
                            },
                            "u_state": {
                                "type": "string"
                            },
                            "u_result": {
                                "type": "string"
                            }
                        }
                    }
                }
            }
        },
        "actions": {
            "Get_OAuth_Token": {
                "type": "Http",
                "inputs": {
                    "uri": "@{appsetting('SNOW_INSTANCE_URL')}/oauth_token.do",
                    "method": "POST",
                    "headers": {
                        "Content-Type": "application/x-www-form-urlencoded"
                    },
                    "body": "@concat('grant_type=client_credentials&client_id=', appsetting('SNOW_CLIENT_ID'), '&client_secret=', encodeUriComponent(appsetting('SNOW_CLIENT_SECRET')))"
                },
                "runAfter": {}
            },
            "Close_Catalog_Task": {
                "type": "Http",
                "inputs": {
                    "uri": "@{appsetting('SNOW_INSTANCE_URL')}/api/now/import/u_stla_api_update_catalog_task",
                    "method": "POST",
                    "headers": {
                        "Authorization": "@concat('Bearer ', body('Get_OAuth_Token')?['access_token'])",
                        "Content-Type": "application/json",
                        "Accept": "application/json"
                    },
                    "body": {
                        "u_catalog_task_sysid": "@{triggerBody()?['u_catalog_task_sysid']}",
                        "u_ritm_number": "@{triggerBody()?['u_ritm_number']}",
                        "u_state": "@{triggerBody()?['u_state']}",
                        "u_result": "@{triggerBody()?['u_result']}"
                    }
                },
                "runAfter": {
                    "Get_OAuth_Token": [
                        "Succeeded"
                    ]
                }
            },
            "Return_Response": {
                "type": "Response",
                "inputs": {
                    "statusCode": 200,
                    "body": {
                        "message": "Catalog task updated successfully",
                        "servicenow_response": "@body('Close_Catalog_Task')"
                    }
                },
                "runAfter": {
                    "Close_Catalog_Task": [
                        "Succeeded"
                    ]
                }
            }
        },
        "outputs": {}
    },
    "kind": "stateful"
}